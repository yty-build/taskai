#!/bin/sh
set -eu

if [ -z "${FAKE_NATIVE_RECORD:-}" ]; then
  printf '%s\n' 'FAKE_NATIVE_RECORD is required' >&2
  exit 9
fi

{
  printf 'cwd=%s\n' "$PWD"
  for argument in "$@"; do
    printf 'arg=%s\n' "$argument"
  done
  printf 'marker=%s\n' "${FAKE_NATIVE_MARKER:-}"
} > "$FAKE_NATIVE_RECORD"

printf '%s\n' 'fake native attached'
exit "${FAKE_NATIVE_EXIT:-0}"
